ROXYWI_VERSION=local
ROXYWI_PUBLIC_URL=https://roxy-wi.example.com
ROXYWI_SECRET_KEY=replace-with-at-least-32-random-characters
ROXYWI_SECRET_PHRASE=replace-with-a-valid-fernet-key
ROXYWI_MYSQL_PASSWORD=replace-with-a-random-database-password
ROXYWI_MYSQL_ROOT_PASSWORD=replace-with-another-random-password
ROXYWI_RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password

# Keep this identity unchanged when restoring/recreating the broker. For an
# existing broker, set its current hostname before applying this manifest.
ROXYWI_RABBITMQ_HOSTNAME=rabbitmq

# Optional shutdown windows. Operations must have time to finish active work.
# ROXYWI_WEB_GRACEFUL_TIMEOUT=120
# ROXYWI_WEB_STOP_GRACE_PERIOD=150s
# ROXYWI_SCHEDULER_STOP_GRACE_PERIOD=5m
# ROXYWI_EVENTS_STOP_GRACE_PERIOD=5m
# ROXYWI_OPERATIONS_STOP_GRACE_PERIOD=30m
