# BEGIN Roxy-WI MANAGED global do not edit it directly
global
    log         127.0.0.1 len 8192 local0
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats
    stats socket *:{{SOCK_PORT}} level admin
    stats socket /var/run/haproxy.sock mode 600 level admin
    server-state-file {{STAT_FILE}}
# END Roxy-WI MANAGED global do not edit it directly

# BEGIN Roxy-WI MANAGED defaults do not edit it directly
defaults
    mode                    http
    log                     global
    # JSON converters escape request data; captured HTTP fields are empty in TCP mode.
    log-format '{"timestamp":"%[date,utime(%Y-%m-%dT%H:%M:%SZ)]","level":"INFO","process_role":"haproxy","message":"%ci:%cp [%[fe_name,json(utf8s)]] %[capture.req.method,json(utf8s)] %[capture.req.uri,json(utf8s)] status=%ST bytes=%B","client_ip":"%ci","client_port":%cp,"frontend":"%[fe_name,json(utf8s)]","backend":"%[be_name,json(utf8s)]","server":"%[srv_name,json(utf8s)]","method":"%[capture.req.method,json(utf8s)]","uri":"%[capture.req.uri,json(utf8s)]","http_version":"%[capture.req.ver,json(utf8s)]","status":%ST,"bytes":"%B","queue_ms":"%Tw","connect_ms":"%Tc","duration_ms":"%Tt","termination_state":"%ts"}'
    option                  dontlognull
    option http-server-close
    option forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000
# END Roxy-WI MANAGED defaults do not edit it directly

# BEGIN Roxy-WI MANAGED listen stats do not edit it directly
listen stats 
    bind *:{{STAT_PORT}}
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
    stats realm HAProxy-04\ Statistics
    stats auth {{STATS_USER}}:{{STATS_PASS}}
    stats admin if TRUE
# END Roxy-WI MANAGED listen stats do not edit it directly

backend per_ip_and_url_rates
    stick-table type binary len 8 size 1m expire 24h store http_req_rate(24h)


backend per_ip_rates
    stick-table type ip size 1m expire 24h store gpc0,gpc0_rate(30s)
